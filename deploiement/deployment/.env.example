# Modèle du fichier .env du serveur (le vrai fichier est généré par Ansible
# à partir des variables de l'inventaire et des secrets Ansible Vault)
COMPOSE_PROJECT_NAME=souverainrecrut
IMAGE_REPO=celoma/souverainrecrut-backend
IMAGE_TAG=1.0.0-05b02ac
APP_ENV=staging
API_PORT=4000
API_VERSION=v1
FRONTEND_URL=http://localhost:5173
POSTGRES_DB=souverainrecrut
POSTGRES_USER=souverainrecrut
POSTGRES_PASSWORD=changer-moi
JWT_SECRET=changer-moi
