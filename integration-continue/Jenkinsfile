// ======================================================
// Pipeline d'intégration continue - SouverainRecrut Backend
// Déclenché à chaque commit (scan du job multibranche toutes les 2 min)
//
//  1. Checkout ........... récupération du commit, calcul du tag <version>-<sha>
//  2. Install ............ npm ci
//  3. Prisma generate .... génération du client Prisma
//  4. Build .............. compilation TypeScript
//  5. Tests .............. Jest + couverture (seuil 80 %), rapports JUnit / Cobertura / lcov
//  6. SonarQube .......... analyse statique + couverture
//  7. Quality Gate ....... attente du verdict SonarQube (échec => pipeline arrêté)
//  8. Docker Build ....... image backend taguée <version>-<sha>
//  9. Trivy .............. scan de l'image (CRITICAL corrigeable => échec)
// 10. SBOM ............... inventaire CycloneDX des composants de l'image (Syft), archivé
// 11. Push Docker Hub .... publication + signature cosign du digest (branches Dev et main)
// 12. Déploiement ........ (main uniquement) déclenche le pipeline GitLab :
//                          staging automatique, puis production sur approbation
// ======================================================
pipeline {
    agent any

    options {
        timestamps()
        disableConcurrentBuilds()
        buildDiscarder(logRotator(numToKeepStr: '10'))
        timeout(time: 30, unit: 'MINUTES')
    }

    environment {
        DOCKERHUB_CREDENTIALS = 'dockerhub-credentials'
        IMAGE_NAME            = 'souverainrecrut-backend'
        // Configuration Docker isolée par build (le login ne reste pas dans JENKINS_HOME)
        DOCKER_CONFIG         = "${WORKSPACE}/.docker"
        // Base de vulnérabilités Trivy conservée entre les builds
        TRIVY_CACHE_DIR       = "${JENKINS_HOME}/.cache/trivy"
        REPORTS               = "${WORKSPACE}/reports"
        // Projet GitLab de déploiement (Celoma/souverainrecrut-deploiement)
        GITLAB_PROJECT_ID     = '88742010'
    }

    stages {

        stage('Checkout') {
            steps {
                checkout scm
                script {
                    env.APP_VERSION = sh(script: "node -p \"require('./backend/package.json').version\"", returnStdout: true).trim()
                    env.GIT_SHORT   = sh(script: 'git rev-parse --short HEAD', returnStdout: true).trim()
                    env.IMAGE_TAG   = "${env.APP_VERSION}-${env.GIT_SHORT}"

                    withCredentials([usernamePassword(credentialsId: env.DOCKERHUB_CREDENTIALS,
                                                      usernameVariable: 'DH_USER',
                                                      passwordVariable: 'DH_TOKEN')]) {
                        env.IMAGE = "${DH_USER}/${env.IMAGE_NAME}"
                    }
                }
                sh 'mkdir -p "$REPORTS"'
                echo "Branche ${env.BRANCH_NAME} - image ${env.IMAGE}:${env.IMAGE_TAG}"
            }
        }

        stage('Install') {
            steps {
                dir('backend') {
                    sh 'npm ci --no-audit --no-fund'
                }
            }
        }

        stage('Prisma generate') {
            steps {
                dir('backend') {
                    sh 'npx prisma generate'
                }
            }
        }

        stage('Build') {
            steps {
                dir('backend') {
                    sh 'npm run build'
                }
            }
        }

        stage('Tests') {
            steps {
                dir('backend') {
                    // Échoue si un test échoue ou si la couverture < 80 % (coverageThreshold)
                    sh 'npm run test:ci'
                }
            }
            post {
                always {
                    junit allowEmptyResults: true, testResults: 'backend/reports/junit.xml'
                    recordCoverage(tools: [[parser: 'COBERTURA', pattern: 'backend/coverage/cobertura-coverage.xml']],
                                   sourceDirectories: [[path: 'backend/src']])
                }
            }
        }

        stage('SonarQube') {
            steps {
                dir('backend') {
                    withSonarQubeEnv('sonarqube') {
                        sh '''
                            sonar-scanner \
                              -Dproject.settings=../integration-continue/sonar/sonar-project.properties \
                              -Dsonar.projectVersion="$IMAGE_TAG"
                        '''
                    }
                }
            }
        }

        stage('Quality Gate') {
            steps {
                timeout(time: 5, unit: 'MINUTES') {
                    // Attend le webhook SonarQube ; un statut ERROR arrête le pipeline
                    waitForQualityGate abortPipeline: true
                }
            }
        }

        stage('Docker Build') {
            steps {
                sh '''
                    docker build \
                      --label org.opencontainers.image.version="$APP_VERSION" \
                      --label org.opencontainers.image.revision="$GIT_COMMIT" \
                      --label org.opencontainers.image.source="$GIT_URL" \
                      -t "$IMAGE:$IMAGE_TAG" backend
                '''
            }
        }

        stage('Trivy') {
            steps {
                sh '''
                    # Rapports complets (HIGH + CRITICAL) archivés avec le build
                    trivy image --no-progress --scanners vuln --severity HIGH,CRITICAL \
                      --format table --output "$REPORTS/trivy-image.txt" "$IMAGE:$IMAGE_TAG"
                    trivy image --no-progress --skip-db-update --scanners vuln --severity HIGH,CRITICAL \
                      --format json --output "$REPORTS/trivy-image.json" "$IMAGE:$IMAGE_TAG"
                    cat "$REPORTS/trivy-image.txt"

                    # Seuil bloquant : aucune vulnérabilité CRITICAL disposant d'un correctif
                    trivy image --no-progress --skip-db-update --scanners vuln \
                      --severity CRITICAL --ignore-unfixed --exit-code 1 "$IMAGE:$IMAGE_TAG"
                '''
            }
        }

        stage('SBOM') {
            steps {
                // Inventaire des composants de l'image (un SBOM par version livrée)
                sh '''
                    syft scan "docker:$IMAGE:$IMAGE_TAG" -q \
                      -o cyclonedx-json="$REPORTS/sbom.cdx.json" -o table="$REPORTS/sbom.txt"
                    node -e 'const b=require(process.argv[1]); console.log("SBOM CycloneDX : " + b.components.length + " composants")' \
                      "$REPORTS/sbom.cdx.json"
                '''
            }
        }

        stage('Push Docker Hub') {
            when {
                anyOf { branch 'Dev'; branch 'main' }
            }
            steps {
                withCredentials([usernamePassword(credentialsId: env.DOCKERHUB_CREDENTIALS,
                                                  usernameVariable: 'DH_USER',
                                                  passwordVariable: 'DH_TOKEN')]) {
                    sh 'echo "$DH_TOKEN" | docker login -u "$DH_USER" --password-stdin'
                }
                sh '''
                    docker push "$IMAGE:$IMAGE_TAG"
                    docker tag  "$IMAGE:$IMAGE_TAG" "$IMAGE:latest"
                    docker push "$IMAGE:latest"
                    # Digest publié : identifiant immuable de l'image déployée en staging puis en production
                    docker image inspect --format '{{index .RepoDigests 0}}' "$IMAGE:$IMAGE_TAG" \
                      | sed 's/.*@//' > "$REPORTS/image-digest.txt"
                '''
                // Signature du digest : GitLab ne déploie qu'une image signée par cette clé
                withCredentials([string(credentialsId: 'cosign-key', variable: 'COSIGN_KEY_B64'),
                                 string(credentialsId: 'cosign-password', variable: 'COSIGN_PASSWORD')]) {
                    sh '''
                        DIGEST=$(cat "$REPORTS/image-digest.txt")
                        # Clé décodée dans un fichier temporaire, sans trace (set +x) :
                        # la valeur décodée n'est pas masquée par Jenkins
                        set +x
                        KEY_FILE=$(mktemp)
                        trap 'rm -f "$KEY_FILE"' EXIT
                        printf '%s' "$COSIGN_KEY_B64" | base64 -d > "$KEY_FILE"
                        echo "+ cosign sign --yes --tlog-upload=false --key <cosign-key> $IMAGE@$DIGEST"
                        cosign sign --yes --tlog-upload=false --key "$KEY_FILE" "$IMAGE@$DIGEST"
                        echo "Image signée : $IMAGE@$DIGEST"
                    '''
                }
                script {
                    env.IMAGE_DIGEST = readFile("${env.REPORTS}/image-digest.txt").trim()
                }
            }
            post {
                always {
                    sh 'docker logout || true'
                }
            }
        }

        stage('Déploiement (GitLab)') {
            when { branch 'main' }
            steps {
                // Pipeline GitLab : staging automatique, puis production après approbation manuelle
                withCredentials([string(credentialsId: 'gitlab-trigger-token', variable: 'GITLAB_TRIGGER_TOKEN')]) {
                    sh '''
                        curl -fsS -X POST \
                          -F "token=$GITLAB_TRIGGER_TOKEN" \
                          -F "ref=main" \
                          -F "variables[IMAGE_TAG]=$IMAGE_TAG" \
                          -F "variables[IMAGE_DIGEST]=$IMAGE_DIGEST" \
                          -F "variables[GIT_COMMIT]=$GIT_COMMIT" \
                          -F "variables[JENKINS_BUILD_URL]=$BUILD_URL" \
                          "https://gitlab.com/api/v4/projects/$GITLAB_PROJECT_ID/trigger/pipeline" \
                          > "$REPORTS/gitlab-pipeline.json"
                        node -e 'const p=require(process.argv[1]); console.log("Pipeline de déploiement GitLab #" + p.id + " : " + p.web_url)' \
                          "$REPORTS/gitlab-pipeline.json"
                    '''
                }
            }
        }
    }

    post {
        always {
            sh '''
                cp backend/reports/junit.xml "$REPORTS/" 2>/dev/null || true
                cp backend/coverage/lcov.info backend/coverage/cobertura-coverage.xml "$REPORTS/" 2>/dev/null || true
                cp backend/.scannerwork/report-task.txt "$REPORTS/sonar-report-task.txt" 2>/dev/null || true
            '''
            archiveArtifacts artifacts: 'reports/**', allowEmptyArchive: true
            sh '''
                docker rmi "$IMAGE:$IMAGE_TAG" "$IMAGE:latest" 2>/dev/null || true
                docker image prune -f || true
            '''
            cleanWs()
        }
        success {
            echo "Image publiée / validée : ${env.IMAGE}:${env.IMAGE_TAG}"
        }
        failure {
            echo 'Pipeline en échec : consulter l\'étape en rouge (tests, Quality Gate, Trivy, signature ou déploiement)'
        }
    }
}
