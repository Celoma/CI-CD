# ======================================================
# Variables de la plateforme CI (copier en .env, jamais commité)
# ======================================================

# Compte administrateur Jenkins
JENKINS_ADMIN_ID=admin
JENKINS_ADMIN_PASSWORD=change-me

# URL publique de Jenkins
JENKINS_URL=http://localhost:8080/

# Docker Hub : nom d'utilisateur (pas l'e-mail) + Access Token (ou mot de passe)
DOCKERHUB_USERNAME=votre-user-dockerhub
DOCKERHUB_TOKEN=dckr_pat_xxxxxxxxxxxxxxxxxxxxxxxx

# Dépôt Git surveillé par le job multibranche
GIT_REPO_URL=https://github.com/VOTRE_UTILISATEUR/souverainrecrut.git

# GID propriétaire de /var/run/docker.sock (0 sous Docker Desktop ; "getent group docker" sous Linux)
DOCKER_GID=0

# SonarQube : nouveau mot de passe admin (12 caractères min., majuscule, minuscule, chiffre, caractère spécial)
SONAR_ADMIN_PASSWORD=Change-me-2026!
# Token d'analyse : rempli automatiquement par ../sonar/setup-sonarqube.sh
SONAR_TOKEN=a-generer

# cosign : signature des images (générer avec : cosign generate-key-pair)
#   COSIGN_KEY_B64 = contenu de cosign.key encodé en base64 sur une ligne (base64 -w0 cosign.key)
COSIGN_PASSWORD=
COSIGN_KEY_B64=

# GitLab : projet de déploiement et jeton de déclenchement (Settings > CI/CD > Pipeline trigger tokens)
GITLAB_PROJECT_ID=
GITLAB_TRIGGER_TOKEN=
