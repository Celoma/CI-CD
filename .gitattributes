# Fichiers exécutés sous Linux (conteneurs, Jenkins) : toujours en fin de ligne LF,
# même sur un poste Windows avec core.autocrlf=true
Jenkinsfile        text eol=lf
Dockerfile         text eol=lf
*.yml              text eol=lf
*.yaml             text eol=lf
*.conf             text eol=lf
*.sh               text eol=lf
.dockerignore      text eol=lf
.env.example       text eol=lf
jenkins/plugins.txt text eol=lf

# Déploiement : fichiers exécutés sous Linux (VM, conteneurs, runner GitLab)
deploiement/** text=auto eol=lf
